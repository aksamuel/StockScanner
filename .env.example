# OpenAI ChatGPT Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
CHATGPT_ENABLED=true

# PIP broker/order safety. CSV/Flex sync is read-only; no order transmitter exists.
PIP_IBKR_ORDER_TRANSMISSION_ENABLED=false

# PIP API uses the caller's verified Supabase access token and RLS.
# Never configure a service-role key in the API environment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Include only the exact browser origins that host Portfolio Intelligence.
PIP_CORS_ORIGINS=http://localhost:8000,https://aksamuel.github.io

# Optional: Chat interface settings
CHATGPT_SYSTEM_PROMPT=You are an expert financial analyst specializing in stock market analysis, technical indicators, and trading strategies. Provide insights based on the StockScanner data provided.
